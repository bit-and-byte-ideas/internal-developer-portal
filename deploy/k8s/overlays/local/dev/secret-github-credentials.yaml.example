# Copy this file to secret-github-credentials.yaml (same directory) and fill
# in real values. That file is gitignored (*-credentials.yaml) — never commit
# real credentials here.
apiVersion: v1
kind: Secret
metadata:
  name: github-backstage-local-credentials
  labels:
    app: backstage
type: Opaque
stringData:
  # GitHub OAuth App credentials — injected as AUTH_GITHUB_CLIENT_ID / AUTH_GITHUB_CLIENT_SECRET env vars
  client-id: REPLACE_WITH_OAUTH_CLIENT_ID
  client-secret: REPLACE_WITH_OAUTH_CLIENT_SECRET
  # GitHub App credentials — mounted as /app/github-app-credentials.yaml
  github-app-credentials.yaml: |
    # Name: <your GitHub App name>
    appId: REPLACE_WITH_APP_ID
    webhookUrl: REPLACE_WITH_WEBHOOK_URL
    clientId: REPLACE_WITH_APP_CLIENT_ID
    clientSecret: REPLACE_WITH_APP_CLIENT_SECRET
    webhookSecret: REPLACE_WITH_WEBHOOK_SECRET
    privateKey: |
      -----BEGIN RSA PRIVATE KEY-----
      REPLACE_WITH_PRIVATE_KEY
      -----END RSA PRIVATE KEY-----
